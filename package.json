{
  "type": "module",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "examine": "deno lint ./src && deno check ./src && deno test ./src",
    "prepack": "deno x glace ./www --out=./out && deno -RW ./x.compat.ts",
    "produce": "deno x glace ./www --out=./out & deno -RNE ./src/mods/srv/bin.ts",
    "develop": "deno x glace ./www --out=./out --dev --watch=./src,./www & deno -RNE ./src/mods/srv/bin.ts --dev"
  },
  "files": [
    "./out"
  ],
  "dependencies": {
    "@hazae41/chemin": "^2.1.6",
    "@hazae41/disposable-stack-polyfill": "^2.0.5",
    "@hazae41/immutable": "^2.1.3",
    "@hazae41/labase": "^1.0.32",
    "@hazae41/modal": "^0.1.2",
    "@hazae41/request-idle-callback-polyfill": "^1.0.0",
    "@hazae41/rewind": "^2.3.12",
    "@hazae41/symbol-dispose-polyfill": "^1.1.2",
    "@heroicons/react": "^2.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@hazae41/glace": "^1.0.32",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "deno": "^2.7.14"
  }
}
